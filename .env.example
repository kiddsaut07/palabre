# ==========================================
# PALABRE MULTI-PROVIDER AI CONFIGURATION
# ==========================================

# Active provider: 'auto', 'ollama', 'qwen', 'deepseek', 'glm', or 'gemini'
AI_PROVIDER="auto"

# Fallback order when AI_PROVIDER is set to 'auto'
# 'ollama' is skipped automatically when OLLAMA_BASE_URL is empty (local open-source, optional)
AI_PROVIDER_ORDER="ollama,qwen,deepseek,glm,gemini"

# --- Provider 0: Ollama (local open-source, optional) ---
# Leave OLLAMA_BASE_URL empty to disable. Set it to enable a fully local model,
# e.g. OLLAMA_BASE_URL="http://localhost:11434/v1" after `ollama pull qwen2.5:7b`
OLLAMA_BASE_URL=""
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_API_KEY=""

# --- Provider 1: Qwen (Alibaba DashScope / OpenAI-compatible) ---
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen2.5-72b-instruct"

# --- Provider 2: DeepSeek (OpenAI-compatible) ---
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# --- Provider 3: GLM / Zhipu AI (OpenAI-compatible) ---
GLM_API_KEY=""
GLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
GLM_MODEL="glm-4-flash"

# --- Provider 4: Gemini (Optional Fallback) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Optional development demo mode (set to true for offline or mock test runs)
DEMO_MODE=false

# --- Speech-to-Text: Open-Source Whisper Worker (Optional) ---
WHISPER_ENDPOINT=""

# Provider Health Cache TTL in milliseconds (default: 30000 = 30 seconds)
HEALTH_CACHE_TTL="30000"

# Developer Diagnostic Panel (disabled by default, can also be toggled with ?debug=ai)
VITE_DEV_PANEL_ENABLED="false"

# Server Port
PORT=3000

# APP_URL: The URL where this applet is hosted (injected in cloud run)
APP_URL="MY_APP_URL"
